# Production secrets — copy to secrets.yaml and replace all CHANGE_ME values.
# Apply with: kubectl apply -f k8s/overlays/prod/secrets.yaml
# NEVER commit secrets.yaml with real values.

apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: kumbi
type: Opaque
stringData:
  DATABASE_URL: postgres://kumbi:CHANGE_ME@postgres:5432/kumbi?sslmode=disable
  JWT_SECRET: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
  ALLOW_ORIGIN: https://yourdomain.com
  STORAGE_PATH: /app/storage
  SEED_ADMIN_EMAIL: admin@kumbi.local
  SEED_ADMIN_PASSWORD: CHANGE_ME
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  WHATSAPP_WEBHOOK_URL: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: kumbi
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME
