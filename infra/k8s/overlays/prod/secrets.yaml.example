---
# Production secrets — copy to secrets.yaml and replace all CHANGE_ME values.
# Run `make generate-secrets` to compute DATABASE_URL from postgres-secret.
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: kumbi
type: Opaque
stringData:
  JWT_SECRET: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
  ALLOW_ORIGIN: https://yourdomain.com
  STORAGE_PATH: /app/storage
  DATABASE_URL: postgres://CHANGE_ME:CHANGE_ME@postgres:5432/CHANGE_ME?sslmode=disable
  SEED_ADMIN_EMAIL: admin@kumbi.local
  SEED_ADMIN_PASSWORD: CHANGE_ME
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  WHATSAPP_WEBHOOK_URL: ""
---
# Postgres credentials — single source of truth.
# DATABASE_URL in backend-secret is computed from these by generate-secrets.sh.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: kumbi
type: Opaque
stringData:
  POSTGRES_USER: kumbi
  POSTGRES_DB: kumbi
  POSTGRES_PASSWORD: CHANGE_ME
