# Dev secrets — copy to secrets.yaml and fill in values.
# Namespace: kumbi (created by base/namespace.yaml)
# POSTGRES_PASSWORD must match the password in DATABASE_URL.

apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: kumbi
type: Opaque
stringData:
  DATABASE_URL: postgres://kumbi:CHANGE_POSTGRES_PASSWORD@postgres:5432/kumbi?sslmode=disable
  JWT_SECRET: CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
  ALLOW_ORIGIN: http://localhost
  STORAGE_PATH: /app/storage
  SEED_ADMIN_EMAIL: admin@kumbi.local
  SEED_ADMIN_PASSWORD: CHANGE_ME
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  WHATSAPP_WEBHOOK_URL: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: kumbi
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_POSTGRES_PASSWORD
