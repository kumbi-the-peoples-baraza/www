apiVersion: v1
kind: Secret
metadata:
  name: app_name_secret
  namespace: app_namespace
type: Opaque
stringData:
  DATABASE_URL: postgres://db_user:db_pwd@postgres:5432/dbname?sslmode=disable
  JWT_SECRET: CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
  ALLOW_ORIGIN: http://localhost
  STORAGE_PATH: /actual_storage_path
  SEED_ADMIN_EMAIL: admin_usr
  SEED_ADMIN_PASSWORD: admin_pwd
  SEED_DEV_EMAIL: dev_usr
  SEED_DEV_PASSWORD: dev_pwd
  SMTP_HOST: ""
  SMTP_PORT: ""
  SMTP_USER: ""
  SMTP_PASS: ""
  WHATSAPP_WEBHOOK_URL: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: pg_secret_obj
  namespace: app_namespace
type: Opaque
stringData:
  POSTGRES_PASSWORD: db_pwd
