---
# Test secrets — copy to secrets.yaml and fill in values.
# Run `make generate-secrets` to compute DATABASE_URL from postgres-secret.
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: kumbi
type: Opaque
stringData:
  JWT_SECRET: CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
  ALLOW_ORIGIN: http://localhost
  STORAGE_PATH: /app/storage
  DATABASE_URL: postgres://CHANGE_ME:CHANGE_ME@postgres:5432/CHANGE_ME?sslmode=disable
  SEED_ADMIN_EMAIL: admin@example.com
  SEED_ADMIN_PASSWORD: CHANGE_ME
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  WHATSAPP_WEBHOOK_URL: ""
---
# Postgres credentials — single source of truth.
# DATABASE_URL in backend-secret is computed from these by generate-secrets.sh.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: kumbi
type: Opaque
stringData:
  POSTGRES_USER: kumbi
  POSTGRES_DB: kumbi
  POSTGRES_PASSWORD: CHANGE_ME
---
# kumbi-app-config — single source of truth for environment settings.
# The Makefile reads these keys to drive deploy/build/tls; DOMAIN is also
# injected into manifests via envsubst at apply time (see base/ingress.yaml
# and the overlay patches: ${DOMAIN}).
# IMPORTANT: keep this ConfigMap at the END of the file — generate-secrets.sh
# targets the first document (backend-secret) only.
apiVersion: v1
kind: ConfigMap
metadata:
  name: kumbi-app-config
  namespace: kumbi
data:
  DOMAIN: test.kumbi.test
  INGRESS_HTTP_PORT: "12080"
  INGRESS_HTTPS_PORT: "12443"
  POSTGRES_DATA_DIR: /var/lib/kumbi/test/postgres-data
  STORAGE_DATA_DIR: /var/lib/kumbi/test/storage
  CERT_DATA_DIR: /var/lib/kumbi/test/certs
  BACKEND_REPLICAS: "3"
  FRONTEND_REPLICAS: "3"
  ACME_EMAIL: admin@kumbi.test
