# Test secrets — copy to secrets.yaml and fill in values
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: kumbi-test
type: Opaque
stringData:
  DATABASE_URL: postgres://kumbi:kumbi_test@postgres:5432/kumbi?sslmode=disable
  JWT_SECRET: test_secret_change_me_32_chars_min_
  ALLOW_ORIGIN: http://localhost
  STORAGE_PATH: /app/storage
  SEED_ADMIN_EMAIL: admin@kumbi.local
  SEED_ADMIN_PASSWORD: CHANGE_ME
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  WHATSAPP_WEBHOOK_URL: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: kumbi-test
type: Opaque
stringData:
  POSTGRES_PASSWORD: kumbi_test
