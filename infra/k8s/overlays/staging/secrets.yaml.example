# Staging secrets — copy to secrets.yaml and replace all CHANGE_ME values
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: kumbi-staging
type: Opaque
stringData:
  DATABASE_URL: postgres://kumbi:CHANGE_ME@postgres:5432/kumbi?sslmode=disable
  JWT_SECRET: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
  ALLOW_ORIGIN: https://staging.yourdomain.com
  STORAGE_PATH: /app/storage
  SEED_ADMIN_EMAIL: admin@kumbi.local
  SEED_ADMIN_PASSWORD: CHANGE_ME
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  WHATSAPP_WEBHOOK_URL: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: kumbi-staging
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME
