# Production secrets — copy to secrets.yaml and fill in CHANGE_ME values
# NEVER commit secrets.yaml with real values.
# Apply with: microk8s kubectl apply -f k8s/prod/secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: kumbi
type: Opaque
stringData:
  # ── Database ────────────────────────────────────────────────────────────────
  DATABASE_URL: postgres://kumbi:CHANGE_ME@postgres:5432/kumbi?sslmode=disable

  # ── Backend ─────────────────────────────────────────────────────────────────
  PORT: "8080"
  ENV: production
  JWT_SECRET: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
  ALLOW_ORIGIN: https://yourdomain.com
  STORAGE_PATH: /app/storage

  # ── Email (optional) ────────────────────────────────────────────────────────
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""

  # ── WhatsApp (optional) ─────────────────────────────────────────────────────
  WHATSAPP_WEBHOOK_URL: ""

  # ── Admin seed credentials (used by the seed-admin Job) ─────────────────────
  SEED_ADMIN_EMAIL: admin@kumbi.local
  SEED_ADMIN_PASSWORD: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: kumbi
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME
