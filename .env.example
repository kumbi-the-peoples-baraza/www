# Local dev secrets — used by native dev (postgres via Docker Compose) only.
# For Kubernetes, secrets live in infra/k8s/overlays/{dev,prod}/secrets.yaml.
# Copy to .env and fill in values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=kumbi_secret
DATABASE_URL=postgres://kumbi:kumbi_secret@localhost:5432/kumbi?sslmode=disable

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development
JWT_SECRET=dev_secret_change_me_32_chars_min
ALLOW_ORIGIN=http://localhost:5173
STORAGE_PATH=./storage

# ── Frontend (Vite build args — baked into the image at build time) ───────────
VITE_API_BASE_URL=http://localhost:8080

# ── Admin seed credentials ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@kumbi.local
SEED_ADMIN_PASSWORD=K@r@k0r@m#

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
WHATSAPP_WEBHOOK_URL=
